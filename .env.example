# App
APP_NAME=Platform Desa
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080
APP_VERSION=1.0.0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platform_desa
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# Upload
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
