# App
APP_NAME=Platform Desa
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080
APP_VERSION=1.0.0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platform_desa
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# Upload — batas ukuran per tipe file
MAX_UPLOAD_IMAGE_MB=10       # foto, input max 10MB → output WebP ~200KB
MAX_UPLOAD_VIDEO_MB=500      # video upload langsung, 0 = bebas
MAX_UPLOAD_DOCUMENT_MB=0     # dokumen, 0 = bebas

# Image Processing
IMAGE_MAX_WIDTH=1920         # resize kalau lebar melebihi ini (px)
IMAGE_MAX_HEIGHT=1920        # resize kalau tinggi melebihi ini (px)
IMAGE_QUALITY=80             # kualitas WebP 1-100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js Revalidation
NEXTJS_URL=http://localhost:3000
NEXTJS_REVALIDATE_SECRET=ganti-dengan-secret-revalidate-yang-kuat